# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (Vite default is 5173)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (use ONE of the two styles)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickfix
# DB_SSL=true   # set for hosted DBs (Render, Neon, Supabase...)

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# SLA mode: "demo" = deadlines in minutes (for the live demo), "standard" = hours/days
SLA_MODE=demo

# Background escalation checker (seconds). 0 disables it.
# Escalation is ALSO checked whenever admin lists/dashboards are fetched and via the "Run check" endpoint.
ESCALATION_INTERVAL_SECONDS=30
